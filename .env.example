# ==========================================
# HimoyaAI Muhit Sozlamalari (Environment Config)
# ==========================================

# Server port
PORT=3001

# LLM API kaliti (Google Gemini yoki OpenAI)
# DIQQAT: Ushbu kalit faqat backend serverda ishlatiladi, frontend kodiga aslo qo'shilmaydi.
# Agar kalit kiritilmasa ham, tizim o'zining mustahkam deterministik xavfsizlik dvigateli orqali 100% oflayn ishlayveradi.
GEMINI_API_KEY=your_gemini_api_key_here
# Yoki alternativ sifatida:
# OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot sozlamalari (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-domain.vercel.app

# Ruxsat etilgan CORS domenlari (vergul bilan ajratilgan)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
